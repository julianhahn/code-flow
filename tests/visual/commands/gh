#!/usr/bin/env python3
"""Serve the visual fixture's PR metadata and GraphQL connections."""
import json
import os
from pathlib import Path
import sys

args = sys.argv[1:]
if args[:2] == ["pr", "view"]:
    print((Path(os.environ["HOME"]) / "pr.json").read_text())
elif args[:2] == ["pr", "list"]:
    branch = args[args.index("--head") + 1]
    print(json.dumps([dict(number=42, state="OPEN", updatedAt="2025-01-01")] if branch == "feature/publishing" else []))
elif args[:2] == ["api", "graphql"]:
    page_info = dict(hasNextPage=False, endCursor=None)
    connections = {field: dict(nodes=[], pageInfo=page_info) for field in ("comments", "reviews", "reviewThreads")}
    if os.environ.get("VISUAL_DISCUSSIONS"):
        connections["comments"]["nodes"].append(dict(
            id="comment-42", author=dict(login="alex"), createdAt="2025-01-01T10:00:00Z",
            body="The published state also appears in the document model.",
            url="https://github.com/example/documents/pull/42#issuecomment-1"))
    print(json.dumps(dict(data=dict(repository=dict(pullRequest=dict(id="PR_42")), root=connections))))
else:
    sys.exit("Unexpected gh invocation " + str(args))
